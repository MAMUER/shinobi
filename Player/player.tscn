[sub_resource type="GDScript" id="GDScript_od3ui"]
resource_name = "camera.gd"
script/source = "extends Camera2D

# Насколько далеко камера смотрит вперёд.
@export var look_ahead_distance: float = 100

# Скорость изменения смещения при развороте.
@export var look_ahead_speed: float = 5.0

# Получаем спрайт GG, чтобы определять направление его взгляда.
@onready var gg_sprite: AnimatedSprite2D = $\"../AnimatedSprite2D\"

# Начальное направление взгляда камеры — вправо.
var look_direction: float = 1.0


func _physics_process(delta: float) -> void:
	# В твоём проекте flip_h = true означает взгляд влево.
	# false — взгляд вправо.
	look_direction = -1.0 if gg_sprite.flip_h else 1.0

	# Выбираем смещение камеры в сторону взгляда GG.
	var target_x: float = look_direction * look_ahead_distance

	# Плавно перемещаем камеру к выбранному смещению.
	position.x = lerpf(
		position.x,
		target_x,
		1.0 - exp(-look_ahead_speed * delta)
	)
"

